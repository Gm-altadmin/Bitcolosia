{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build:vercel && pnpm exec esbuild server/_core/app.ts --bundle --platform=node --format=esm --packages=external --outfile=api/_lib/app.js",
  "outputDirectory": "dist/public",
  "functions": { "api/index.ts": { "includeFiles": "server/**" } },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/scheduled/daily-parcel-valuation", "schedule": "30 7 * * *" },
    { "path": "/api/scheduled/commentator-awards", "schedule": "45 7 * * *" },
    { "path": "/api/scheduled/commentator-forecasts", "schedule": "30 8 * * *" },
    { "path": "/api/scheduled/commentator-research", "schedule": "0 17 * * *" }
  ]
}
